# Copy to backend/.env and adjust. Read by the backend (pydantic-settings) and by docker compose.
# Real environment variables take precedence over values in .env.
# List/object values must be JSON on a single line.

APP_NAME=CKAN Site Search API
DEBUG=false

# Origins allowed to call the API from a browser. Not needed when the frontend is served
# by the same container (docker), only for `npm start` on :4200 during development.
CORS_ORIGINS=["http://localhost:4200"]

# Directory with the built Angular app. Set automatically in the docker image; leave unset
# when running the frontend separately with `npm start`.
# FRONTEND_DIR=/app/static

# Sources to search. Fields per source:
#   key, label, base_url              required
#   api_key                           optional, for private datasets
#   source_type                       default "ckan"
#   dataset_type                      default "dataset" (e.g. "instrument" for PIDInst)
#   base_doi_url                      e.g. https://doi.org/ (prod) or https://handle.test.datacite.org/ (test)
#   enabled                           default true
#   environment                       dev | staging | prod (shown as a badge in the UI)
# If SOURCES is not set, the production defaults in app/core/config.py are used.
SOURCES=[{"key":"sample_repo","label":"Sample Repository","base_url":"https://sample.data.auscope.org.au/","dataset_type":"dataset","base_doi_url":"https://doi.org/","environment":"prod"},{"key":"data_repo","label":"Data Repository","base_url":"https://repository.data.auscope.org.au/","dataset_type":"dataset","base_doi_url":"https://doi.org/","environment":"prod"},{"key":"pidinst_repo","label":"PIDInst Repository","base_url":"https://pidinst.data.auscope.org.au/","dataset_type":"instrument","base_doi_url":"https://doi.org/","environment":"prod"}]

# Dev/test sites example:
# SOURCES=[{"key":"sample_repo","label":"Sample Repository","base_url":"https://sample-dev.data.auscope.org.au/","dataset_type":"dataset","base_doi_url":"https://handle.test.datacite.org/","environment":"dev"},{"key":"data_repo","label":"Data Repository","base_url":"https://repository-dev.data.auscope.org.au/","dataset_type":"dataset","base_doi_url":"https://handle.test.datacite.org/","environment":"dev"},{"key":"pidinst_repo","label":"PIDInst Repository","base_url":"https://pidinst-dev.data.auscope.org.au/","dataset_type":"instrument","base_doi_url":"https://handle.test.datacite.org/","environment":"dev"}]
